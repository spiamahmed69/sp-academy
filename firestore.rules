/**
 * SP Academy — Firestore security rules (Phase 9 draft, v8).
 *
 * Principles:
 * - Auth is required for all writes; public reads only where the Phase 1
 *   public website needs them (published courses/books/blogs).
 * - A user can read/write ONLY their own users/{uid} and students/{uid} docs.
 * - Roles are NEVER self-assigned: users/{uid}.role can be set only at
 *   creation (role == 'student') or changed by an admin (custom claim or an
 *   admin's trusted write). Clients cannot grant themselves a privileged role.
 * - `roles` and `permissions` collections are admin-only (read: signed-in
 *   users may read role definitions for UI labels; write: admins only).
 * - Courses: public read ONLY when status == 'published'. Writes by admins,
 *   or by the owning teacher (instructorId == uid) for their own courses.
 * - Enrollments: a user may create ONLY their own enrollment, ONLY for a
 *   free course (paymentStatus == 'free', pricePaid == 0) — paid enrollment
 *   is created server-side with payment verification (orders arrive in
 *   Phase 8; the backend activates the enrollment in Phase 10). Owners may
 *   update only their progress fields, never price/payment/ownership.
 * - Books (Phase 8): public read only when status == 'published'; writes
 *   by admins only. Covers are URL fields (ImgBB via backend, Phase 10).
 * - Orders (Phase 8): a signed-in user may create ONLY their own order,
 *   with paymentStatus 'pending_verification' (bKash/Nagad/card) or
 *   'cod_due' (COD) — NEVER 'paid'. Only the backend (Phase 10) may mark
 *   an order paid after gateway verification, so no client can fake a
 *   successful payment. Admins may change ONLY the fulfilment status
 *   (pending → confirmed → shipped → delivered / cancelled) — never the
 *   payment status, items, totals or customer. COD-for-course is blocked
 *   client-side and re-checked by the backend in Phase 10.
 * - Carts (Phase 8): carts/{uid} is the owner's private cart mirror —
 *   read/write by the owner only.
 * - Notifications (Phase 9): notifications/{id} is read by its owner or an
 *   admin; the owner may update ONLY the `read` field (mark read). Clients
 *   can NEVER create a notification — only admins (or the Phase 10 backend)
 *   may create one, so no fake notification can be invented from a browser.
 * - Support tickets (Phase 9): a signed-in user may create ONLY their own
 *   ticket, with status 'open' and an empty replies list. The owner may
 *   read their own tickets; admins / moderators may read all. Only an
 *   admin / moderator may append a reply or change the status — the owner
 *   can never change their own ticket's status or fake an admin reply.
 *   Ticket replies are plain text, never presented as coming from anyone
 *   other than the admin who wrote them.
 * - Certificates: read only by the owner or an admin; writes stay blocked
 *   until the backend (Phase 10) issues them server-side. No client can mint one.
 * - Exams (Phase 6): metadata is public when published; questions live in
 *   exams/{id}/questions and contain NO answers, so students may read them
 *   during an attempt. Answer keys live in examKeys/{id} and are readable
 *   ONLY by the exam's teacher / an admin — the student client NEVER gets
 *   them. Attempts are examAttempts/{uid}_{examId}: one per student per
 *   exam (create fails when the doc exists; the id itself pins owner+exam).
 *   The owner may update ONLY in_progress → submitted (answers +
 *   submittedAt); the exam's teacher / admin may update ONLY submitted →
 *   evaluated (score fields) — nobody can edit an attempt after it is
 *   evaluated, and nobody can invent a score for themselves.
 * - Live classes (Phase 5): the schedule is public to read (except
 *   cancelled classes, which only admins / the owning teacher see);
 *   teachers may create ONLY their own classes as 'scheduled' and update
 *   ONLY their own classes (never reassigning teacherId/courseId);
 *   admins manage all. The joinUrl is public by design — students need
 *   it to join — but the UI shows it only when the class actually has one.
 * - Enrollments: teachers may READ enrollments of their own courses
 *   (counts + progress for the teacher dashboard) but never write them.
 * - classAttendance is reserved: reads for the class teacher / admin,
 *   writes blocked until a real live session exists to mark attendance
 *   against — marking attendance without a session would be invented data.
 * - Admin (Phase 7): admins may read all user docs and update any user's
 *   role — EXCEPT their own role (no self-assignment / self-demotion, even
 *   for an admin). The last-super-admin guard lives in the client +
 *   backend (Phase 10) because rules cannot count documents. A disabled
 *   account (users/{uid}.disabled == true) cannot create enrollments or
 *   exam attempts. Full Auth-level deactivation (blocking login) needs the
 *   Admin SDK and arrives with the backend in Phase 10.
 * - These rules are the enforcement layer. Client-side guards
 *   (src/components/ProtectedRoute.tsx, src/lib/roles.ts) are UI only.
 *
 * HOW TO PUBLISH (see docs/firebase-setup.md):
 *   Firebase console → Firestore Database → Rules → paste this file → Publish.
 *   Test with the Rules Playground before publishing.
 */
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return signedIn() && request.auth.token.role is string
        ? request.auth.token.role
        : 'student';
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin';
    }

    function isSuperAdmin() {
      return role() == 'super_admin';
    }

    function isTeacher() {
      return role() == 'teacher';
    }

    // True when the signed-in user's profile is flagged disabled by an admin.
    // get() is only evaluated when the profile doc exists (&& short-circuits).
    function isAccountDisabled() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == true;
    }

    function courseDoc(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }

    function isCourseTeacher(courseId) {
      return isTeacher() && courseDoc(courseId).instructorId == request.auth.uid;
    }

    function isCourseTeacherById(courseId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/courses/$(courseId))
        && courseDoc(courseId).instructorId == request.auth.uid;
    }

    function isCourseVisible(courseId) {
      return courseDoc(courseId).status == 'published' || isAdmin() || isCourseTeacher(courseId);
    }

    function examDoc(examId) {
      return get(/databases/$(database)/documents/exams/$(examId)).data;
    }

    function isExamTeacher(examId) {
      return isTeacher() && examDoc(examId).teacherId == request.auth.uid;
    }

    function isExamTeacherById(examId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/exams/$(examId))
        && examDoc(examId).teacherId == request.auth.uid;
    }

    function isExamPublished(examId) {
      return exists(/databases/$(database)/documents/exams/$(examId))
        && examDoc(examId).status == 'published';
    }

    // ---- users: own doc only; role can only be 'student' on create ----
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.email is string
        && request.resource.data.uid == uid;
      // Owner may update name/phone only — never their own role, email or disabled flag.
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'uid', 'disabled']);
      // Admins may update any user — except their OWN role (no self-assignment
      // or self-demotion, even for an admin). The last-super-admin guard
      // lives in the client + backend (Phase 10): rules cannot count docs.
      allow update: if isAdmin()
        && (request.auth.uid != uid
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isSuperAdmin();
    }

    // ---- students: own record only; admins may read ----
    match /students/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---- roles / permissions: read by signed-in users, write by admins ----
    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }
    match /permissions/{permId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // ---- courses: public read only when published; writes by admin / owning teacher ----
    match /courses/{courseId} {
      allow read: if resource.data.status == 'published' || isAdmin()
        || (signedIn() && resource.data.instructorId == request.auth.uid);
      allow create: if isAdmin()
        || (isTeacher()
          && request.resource.data.instructorId == request.auth.uid
          && request.resource.data.status == 'draft');
      allow update: if isAdmin()
        || (isTeacher() && resource.data.instructorId == request.auth.uid);
      allow delete: if isAdmin();

      // Lessons inherit the course's visibility; writes mirror the course's.
      match /lessons/{lessonId} {
        allow read: if isCourseVisible(courseId);
        allow create, update, delete: if isAdmin() || isCourseTeacher(courseId);
      }
    }

    // ---- enrollments: free-only self-enrollment; owners update progress only ----
    // Teachers may READ enrollments of their own courses (dashboard counts);
    // they may never create / update / delete them.
    match /enrollments/{enrollmentId} {
      allow read: if isSelf(resource.data.userId) || isAdmin()
        || isCourseTeacherById(resource.data.courseId);
      // A client may create ONLY its own enrollment, ONLY for a free course.
      // Paid enrollments are created server-side with payment verification
      // (orders in Phase 8, activation in the Phase 10 backend).
      // A disabled account cannot enroll at all (Phase 7).
      allow create: if signedIn()
        && !isAccountDisabled()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.paymentStatus == 'free'
        && request.resource.data.pricePaid == 0
        && request.resource.data.completedLessonIds == []
        && request.resource.data.progressPercent == 0
        && request.resource.data.courseId is string;
      // Owner may update progress fields only — never price/payment/ownership.
      allow update: if isSelf(resource.data.userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'courseId', 'paymentStatus', 'pricePaid', 'status', 'enrolledAt']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- certificates: read only by owner/admin; issued server-side in Phase 6 ----
    match /certificates/{certId} {
      allow read: if isSelf(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    // ---- exams: public when published; questions carry no answers; keys are teacher/admin only ----
    match /exams/{examId} {
      allow read: if resource.data.status == 'published' || isAdmin()
        || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin()
        || (isTeacher()
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == 'draft'
          && request.resource.data.title is string
          && request.resource.data.durationMin is number
          && request.resource.data.durationMin >= 5
          && request.resource.data.durationMin <= 480
          && request.resource.data.questionCount is number
          && request.resource.data.totalMarks is number);
      // Owning teacher / admin may update, but never reassign the exam.
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);

      // Questions: student-safe (no correctAnswer field exists here).
      match /questions/{questionId} {
        allow read: if isExamPublished(examId) || isAdmin() || isExamTeacher(examId);
        allow create, update, delete: if isAdmin() || isExamTeacher(examId);
      }
    }

    // Answer keys: ONLY the exam's teacher / an admin. Students never read this.
    match /examKeys/{examId} {
      allow read: if isAdmin() || isExamTeacherById(examId);
      allow write: if isAdmin() || isExamTeacherById(examId);
    }

    // ---- exam attempts: one per student per exam; submit once; evaluate once ----
    match /examAttempts/{attemptId} {
      allow read: if isSelf(resource.data.userId) || isAdmin() || isExamTeacherById(resource.data.examId);
      // Create fails when the doc already exists (Firestore create semantics),
      // so a second attempt can never be created — by this client or any other.
      // A disabled account cannot start an attempt (Phase 7).
      allow create: if signedIn()
        && !isAccountDisabled()
        && request.resource.data.userId == request.auth.uid
        && attemptId == request.auth.uid + '_' + request.resource.data.examId
        && request.resource.data.status == 'in_progress'
        && request.resource.data.answers is map
        && request.resource.data.answers.size() == 0
        && request.resource.data.score == null;
      // Owner submits exactly once: in_progress → submitted, answers + submittedAt only.
      allow update: if isSelf(resource.data.userId)
        && resource.data.status == 'in_progress'
        && request.resource.data.status == 'submitted'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'examId', 'examTitle', 'score', 'totalMarks', 'correctCount', 'wrongCount', 'skippedCount', 'perQuestion', 'evaluatedAt', 'evaluatedBy', 'startedAt']);
      // Exam teacher / admin evaluates exactly once: submitted → evaluated, score fields only.
      allow update: if (isAdmin() || isExamTeacherById(resource.data.examId))
        && resource.data.status == 'submitted'
        && request.resource.data.status == 'evaluated'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'examId', 'examTitle', 'answers', 'startedAt', 'submittedAt']);
      allow delete: if isAdmin();
    }

    // ---- live classes: public schedule; teachers manage only their own ----
    match /liveClasses/{classId} {
      allow read: if resource.data.status in ['scheduled', 'live', 'ended']
        || isAdmin()
        || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow create: if isAdmin()
        || (isTeacher()
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.status == 'scheduled'
          && request.resource.data.title is string
          && request.resource.data.subject is string
          && request.resource.data.startsAt is timestamp
          && request.resource.data.durationMin is number
          && request.resource.data.durationMin >= 5
          && request.resource.data.durationMin <= 480);
      // Owning teacher / admin may update, but never reassign the class.
      allow update: if isAdmin()
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.courseId == resource.data.courseId);
      allow delete: if isAdmin();
    }

    // ---- class attendance: reserved until a real live session exists ----
    match /classAttendance/{attendanceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow write: if false;
    }

    match /courseCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // ---- books: public read when published; admin writes only ----
    match /books/{bookId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    // ---- orders: own orders only; paymentStatus can NEVER be 'paid' from a client ----
    match /orders/{orderId} {
      allow read: if isSelf(resource.data.userId) || isAdmin();
      allow create: if signedIn()
        && !isAccountDisabled()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderNo is string
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 20
        && request.resource.data.subtotal is number
        && request.resource.data.deliveryFee is number
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.paymentMethod in ['bkash', 'nagad', 'card', 'cod']
        && request.resource.data.paymentStatus in ['pending_verification', 'cod_due']
        && request.resource.data.orderStatus == 'pending'
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string;
      // Admins may change the fulfilment status only — never payment status,
      // items, totals, customer or order number. 'paid' is set by the backend
      // (Phase 10) after gateway verification; no client can fake it.
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'items', 'subtotal', 'deliveryFee', 'total', 'paymentMethod', 'paymentStatus', 'customer', 'orderNo', 'createdAt']);
      allow delete: if isAdmin();
    }
    // ---- carts: the owner's private cart mirror (read/write by owner only) ----
    match /carts/{uid} {
      allow read, write: if isSelf(uid);
    }
    // ---- notifications: owner reads + marks read only; created by admin/backend only ----
    match /notifications/{notificationId} {
      allow read: if isSelf(resource.data.userId) || isAdmin();
      // Only an admin (or the Phase 10 backend) may create a notification —
      // no client can invent one for itself or anyone else.
      allow create: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.title is string
        && request.resource.data.type in ['enrollment', 'exam', 'class', 'order', 'support', 'system']
        && request.resource.data.read == false;
      // The owner may change ONLY the `read` flag — never title/body/type/owner.
      allow update: if isSelf(resource.data.userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'title', 'body', 'type', 'link', 'createdAt']);
      allow delete: if isAdmin();
    }
    // ---- support tickets: owner creates own ticket; admin/moderator reply + set status ----
    match /supportTickets/{ticketId} {
      allow read: if isSelf(resource.data.userId) || isAdmin()
        || (signedIn() && role() == 'moderator');
      // A signed-in user may create ONLY their own ticket, always 'open',
      // with an empty replies list — never a fake admin reply or status.
      allow create: if signedIn()
        && !isAccountDisabled()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.message is string
        && request.resource.data.category in ['course', 'payment', 'exam', 'technical', 'general']
        && request.resource.data.status == 'open'
        && request.resource.data.replies == [];
      // Admin / moderator may append a reply or change the status — never
      // reassign the ticket, edit the user's message, or fake the author.
      allow update: if (isAdmin() || (signedIn() && role() == 'moderator'))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['userId', 'userName', 'userEmail', 'subject', 'category', 'message', 'createdAt']);
      allow delete: if isSuperAdmin();
    }
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- everything else: deny by default ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
