# SP Academy — environment placeholders (Phase 2 uses VITE_FIREBASE_*; no real keys here)
# Copy to .env.local when the Firebase project exists (see docs/firebase-setup.md).
# Never commit real keys.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_API_URL=http://localhost:5000/api

# --- ImgBB (centralized public-image hosting) ---
# Backend server-side env ONLY (Node.js + Express, Phase 2+). The key must NEVER
# appear in React source, browser requests, Vite/VITE_* env, or GitHub.
# Phase 1 implements NO upload and embeds NO key — this is a placeholder only.
# IMGBB_API_KEY=
